# =============================================================================
# SHREWD. Blog Environment Variables Example Template
# Duplicate this file to .env and replace placeholder values with your credentials
# =============================================================================

# Site URL (Canonical domain for Astro build)
PUBLIC_SITE_URL=https://forum.shr3wd.workers.dev
SITE_URL=https://forum.shr3wd.workers.dev

# Web3Forms API Access Key (Used for Contact and Write For Us forms)
# Obtain from https://web3forms.com
PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here

# Cloudflare Web Analytics Beacon Token
# Obtain from Cloudflare Dashboard -> Web Analytics
PUBLIC_CLOUDFLARE_BEACON_TOKEN=your-cloudflare-beacon-token-here
CLOUDFLARE_BEACON_TOKEN=your-cloudflare-beacon-token-here

# Decap CMS & Cloudflare Auth Worker Configuration
PUBLIC_CMS_BACKEND_URL=https://shrewd-auth.shr3wd.workers.dev
PUBLIC_GITHUB_REPO=sarojkumarvivek/shrewdforum-blog

# Cloudflare Pages CI/CD Deployment Secrets (Required in GitHub Repo Secrets)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
