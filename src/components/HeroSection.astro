---
---

<section class="hero" aria-labelledby="hero-heading">
  <!-- Animated mesh gradient background -->
  <div class="hero-mesh" aria-hidden="true">
    <div class="mesh-blob mesh-blob--1"></div>
    <div class="mesh-blob mesh-blob--2"></div>
    <div class="mesh-blob mesh-blob--3"></div>
  </div>
  <!-- Subtle grid pattern overlay -->
  <div class="hero-grid-pattern" aria-hidden="true"></div>

  <div class="container">
    <div class="hero-inner">
      <!-- Left: Content -->
      <div class="hero-content reveal reveal--left">
        <div class="hero-badge" role="note">
          <span class="hero-badge-pulse" aria-hidden="true"></span>
          CYBERSECURITY RESEARCH
        </div>

        <h1 class="hero-title" id="hero-heading">
          Don't Just Explain Cybersecurity.
          <span class="line-cyan">Test It.</span>
        </h1>

        <p class="hero-desc">
          Practical lab experiments, Windows security hardening, vulnerability management,
          and evidence-driven research. Every finding backed by lab logs and verified fixes.
        </p>

        <div class="hero-buttons">
          <a href="/blog" class="btn btn--primary btn--lg" id="hero-explore-btn">
            Explore Labs →
          </a>
          <a href="/write-for-us" class="btn btn--outline btn--lg" id="hero-write-btn">
            Write For Us
          </a>
        </div>

        <div class="hero-trust" role="list" aria-label="Trust indicators">
          <span role="listitem">Evidence-driven</span>
          <span role="listitem">Lab-tested</span>
          <span role="listitem">Practitioner-written</span>
        </div>
      </div>

      <!-- Right: Terminal Mockup with typing animation -->
      <div class="terminal reveal reveal--right" role="img" aria-label="Terminal showing Nmap vulnerability scan output">
        <div class="terminal-header">
          <span class="terminal-dot red" aria-hidden="true"></span>
          <span class="terminal-dot yellow" aria-hidden="true"></span>
          <span class="terminal-dot green" aria-hidden="true"></span>
          <span class="terminal-title">shrewd@lab: ~ bash</span>
        </div>
        <div class="terminal-body" id="terminal-output">
          <!-- Lines will be typed in by JS -->
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Terminal typing animation
  const terminalLines = [
    { type: 'command', text: '$ nmap -sV --script vuln 192.168.1.1' },
    { type: 'output', text: 'Starting Nmap 7.94 ( https://nmap.org )' },
    { type: 'output', text: 'Scan report for 192.168.1.1' },
    { type: 'blank' },
    { type: 'output', text: 'PORT     STATE SERVICE  VERSION' },
    { type: 'highlight', text: '445/tcp', after: '  open  msrpc    Microsoft Windows RPC' },
    { type: 'output', text: '| smb-vuln-ms17-010:' },
    { type: 'vulnerable', text: '|   VULNERABLE' },
    { type: 'output', text: '|   Risk factor: <span class="terminal-high">HIGH</span>' },
    { type: 'output', text: '|   CVE: <span class="terminal-cve">CVE-2017-0144</span>' },
    { type: 'output', text: '|   CVSS: <span class="terminal-high">9.3</span>' },
    { type: 'output', text: '|_ EternalBlue SMB Remote Code Execution' },
    { type: 'blank' },
    { type: 'output', text: '3389/tcp open  ms-wbt-server' },
    { type: 'output', text: '| rdp-vuln-ms12-020:' },
    { type: 'vulnerable', text: '|   VULNERABLE (DoS)' },
    { type: 'blank' },
    { type: 'cursor' },
  ];

  function buildTerminal() {
    const container = document.getElementById('terminal-output');
    if (!container) return;

    let lineIndex = 0;
    let charIndex = 0;
    let currentLine: HTMLDivElement | null = null;

    function typeLine() {
      if (lineIndex >= terminalLines.length) return;

      const line = terminalLines[lineIndex];

      if (line.type === 'blank') {
        container.appendChild(document.createElement('br'));
        lineIndex++;
        setTimeout(typeLine, 60);
        return;
      }

      if (line.type === 'cursor') {
        const div = document.createElement('div');
        div.innerHTML = '<span class="terminal-prompt">$</span> <span class="terminal-cursor"></span>';
        container.appendChild(div);
        return;
      }

      if (!currentLine) {
        currentLine = document.createElement('div');
        container.appendChild(currentLine);
      }

      if (line.type === 'command') {
        // Type character by character
        const fullText = line.text;
        if (charIndex === 0) {
          currentLine.innerHTML = '<span class="terminal-prompt">$</span> <span class="terminal-cmd"></span>';
        }
        const cmdSpan = currentLine.querySelector('.terminal-cmd');
        if (cmdSpan && charIndex < fullText.length - 2) {
          // Skip the "$ " prefix
          const idx = charIndex + 2;
          cmdSpan.textContent = fullText.substring(2, idx + 1);
          charIndex++;
          setTimeout(typeLine, 25 + Math.random() * 35);
          return;
        }
        charIndex = 0;
        currentLine = null;
        lineIndex++;
        setTimeout(typeLine, 400);
        return;
      }

      if (line.type === 'highlight') {
        currentLine.innerHTML = `<span class="terminal-cve">${line.text}</span><span class="terminal-output">${line.after}</span>`;
      } else if (line.type === 'vulnerable') {
        currentLine.innerHTML = `<span class="terminal-vulnerable">${line.text}</span>`;
      } else {
        currentLine.innerHTML = `<span class="terminal-output">${line.text}</span>`;
      }

      currentLine = null;
      lineIndex++;
      setTimeout(typeLine, 50 + Math.random() * 60);
    }

    // Start after a short delay
    setTimeout(typeLine, 800);
  }

  // Run on page load
  buildTerminal();
</script>
