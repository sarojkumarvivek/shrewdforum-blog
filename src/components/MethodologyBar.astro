---
const steps = [
  { label: 'Question', icon: '❓' },
  { label: 'Research', icon: '📖' },
  { label: 'Lab', icon: '🔬' },
  { label: 'Evidence', icon: '📸' },
  { label: 'Fix', icon: '🔧' },
  { label: 'Retest', icon: '🔄' },
  { label: 'Result', icon: '✅' },
];
---

<section class="methodology reveal" aria-label="Research methodology">
  <div class="container">
    <div class="methodology-inner" role="list" aria-label="Methodology steps">
      {steps.map((step, i) => (
        <div class="methodology-step" role="listitem" style={`--step-delay: ${i * 0.1}s`}>
          <span class="methodology-step-icon" aria-hidden="true">{step.icon}</span>
          <span class="methodology-step-label">{step.label}</span>
          {i < steps.length - 1 && (
            <span class="methodology-arrow" aria-hidden="true">
              <svg width="24" height="12" viewBox="0 0 24 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 6H20M20 6L15 1M20 6L15 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .methodology-step-icon {
    font-size: 1.25rem;
    display: none;
  }

  .methodology-step {
    animation: stepFadeIn 0.5s ease forwards;
    animation-delay: var(--step-delay);
    opacity: 0;
  }

  @keyframes stepFadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .methodology-arrow svg {
    display: block;
    animation: arrowPulse 2s ease-in-out infinite;
    animation-delay: var(--step-delay);
  }

  @keyframes arrowPulse {
    0%, 100% { opacity: 0.5; transform: translateX(0); }
    50% { opacity: 1; transform: translateX(3px); }
  }

  @media (max-width: 768px) {
    .methodology-step-icon {
      display: inline;
    }
    .methodology-step-label {
      font-size: 0.8125rem;
    }
    .methodology-arrow svg {
      width: 16px;
      height: 8px;
    }
  }
</style>
