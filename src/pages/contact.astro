---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const web3FormsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || import.meta.env.WEB3FORMS_ACCESS_KEY || "";
---

<BaseLayout
  title="Contact"
  description="Get in touch with the SHREWD. cybersecurity research team. Questions, collaborations, or tips about vulnerabilities."
>
  <Header />

  <main id="main-content">
    <!-- Page Hero -->
    <section class="page-hero">
      <div class="container">
        <div class="badge badge--cyan" style="margin-bottom: var(--space-4);">
          Contact
        </div>
        <h1 class="page-title">Get In Touch</h1>
        <p class="page-subtitle">
          Questions about our research? Want to collaborate? Found a factual
          error? We read every message.
        </p>
      </div>
    </section>

    <section class="content-section">
      <div class="container">
        <div class="content-block">
          <!-- Left: Form -->
          <div>
            <h2 style="margin-bottom: var(--space-8);">Send a Message</h2>
            <form
              action="https://api.web3forms.com/submit"
              method="POST"
              class="contact-form"
              id="contact-form"
              aria-label="Contact form"
            >
              <!-- Web3Forms Access Key from environment variables -->
              <input
                type="hidden"
                name="access_key"
                value={web3FormsAccessKey}
              />
              <input
                type="hidden"
                name="subject"
                value="New Contact Message from SHREWD"
              />
              <input type="hidden" name="from_name" value="SHREWD Website" />

              <!-- Anti-spam Honeypot (hidden from real users) -->
              <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

              <div class="form-group">
                <label class="form-label" for="contact-name">Name</label>
                <input
                  class="form-input"
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  maxlength="100"
                  autocomplete="name"
                  placeholder="Your name"
                />
              </div>

              <div class="form-group">
                <label class="form-label" for="contact-email">Email</label>
                <input
                  class="form-input"
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  maxlength="150"
                  autocomplete="email"
                  placeholder="your@email.com"
                />
              </div>

              <div class="form-group">
                <label class="form-label" for="contact-topic">Topic</label>
                <select class="form-select" id="contact-topic" name="topic">
                  <option value="general">General Question</option>
                  <option value="research">Research Collaboration</option>
                  <option value="correction">Factual Correction</option>
                  <option value="tip">Vulnerability Tip</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="contact-message">Message</label>
                <textarea
                  class="form-textarea"
                  id="contact-message"
                  name="message"
                  required
                  maxlength="5000"
                  placeholder="What's on your mind?"
                  rows="5"></textarea>
              </div>

              <button
                type="submit"
                class="btn btn--primary"
                id="contact-submit-btn"
                style="width: 100%; justify-content: center;"
              >
                Send Message →
              </button>
            </form>
          </div>

          <!-- Right: Info -->
          <div>
            <h2 style="margin-bottom: var(--space-6);">
              Other Ways to Connect
            </h2>

            <div
              style="display: flex; flex-direction: column; gap: var(--space-4);"
            >
              <div class="info-card">
                <div style="font-size: 1.5rem; margin-bottom: var(--space-3);">
                  🐛
                </div>
                <div
                  style="font-weight: 700; color: var(--color-text); margin-bottom: var(--space-2);"
                >
                  Found an Error?
                </div>
                <p style="font-size: 0.9375rem; margin: 0;">
                  If any of our lab findings are factually incorrect, please
                  tell us. We'll update the post with a correction notice and
                  give you credit.
                </p>
              </div>

              <div class="info-card">
                <div style="font-size: 1.5rem; margin-bottom: var(--space-3);">
                  🔬
                </div>
                <div
                  style="font-weight: 700; color: var(--color-text); margin-bottom: var(--space-2);"
                >
                  Collaboration
                </div>
                <p style="font-size: 0.9375rem; margin: 0;">
                  We're open to joint research projects, lab sharing, and tool
                  development. If you have an interesting question, let's find
                  the answer together.
                </p>
              </div>

              <div class="info-card">
                <div style="font-size: 1.5rem; margin-bottom: var(--space-3);">
                  ✍️
                </div>
                <div
                  style="font-weight: 700; color: var(--color-text); margin-bottom: var(--space-2);"
                >
                  Write For Us
                </div>
                <p style="font-size: 0.9375rem; margin: 0 0 var(--space-3);">
                  Want to contribute research? Check out our writer guidelines
                  first.
                </p>
                <a href="/write-for-us" class="btn btn--outline btn--sm"
                  >View Guidelines →</a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;

    if (contactForm && submitBtn) {
      contactForm.addEventListener('submit', (e) => {
        const lastSubmit = sessionStorage.getItem('last_contact_submit');
        const now = Date.now();
        if (lastSubmit && now - parseInt(lastSubmit, 10) < 15000) {
          e.preventDefault();
          alert('Please wait a few seconds before submitting another message.');
          return;
        }
        sessionStorage.setItem('last_contact_submit', String(now));
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending Message...';
      });
    }
  </script>

  <Footer />
</BaseLayout>
