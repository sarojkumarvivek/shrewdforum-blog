---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCard from '../components/BlogCard.astro';
import { getReadingTime } from '../utils/readingTime';

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  relatedPosts?: CollectionEntry<'blog'>[];
}

const { post, headings = [], relatedPosts = [] } = Astro.props;
const { title, description, author, pubDate, updatedDate, category, tags, image, difficulty, authorBio, authorGitHub } = post.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const updatedFormatted = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Category badge class mapping
const categoryBadgeMap: Record<string, string> = {
  'Windows Security': 'badge--windows',
  'Vulnerability Management': 'badge--vuln',
  'Windows Server': 'badge--server',
  'Nessus & Tenable': 'badge--nessus',
  'Hardening & Compliance': 'badge--hardening',
  'Lab Experiments': 'badge--lab',
};

const categoryBadge = categoryBadgeMap[category] || 'badge--cyan';
const authorInitial = author.charAt(0).toUpperCase();
const readTimeMin = getReadingTime(post.body);

// Filter headings for Table of Contents (H2 and H3 only)
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

// Canonical and OpenGraph origin for JSON-LD
const siteOrigin = Astro.site ? Astro.site.origin : (import.meta.env.PUBLIC_SITE_URL || 'https://forum.shr3wd.workers.dev');
const postUrl = new URL(Astro.url.pathname, siteOrigin).href;
const postImageUrl = image
  ? (image.startsWith('http') ? image : new URL(image, siteOrigin).href)
  : new URL('/og-default.png', siteOrigin).href;

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  'headline': title,
  'description': description,
  'image': postImageUrl,
  'datePublished': pubDate.toISOString(),
  'dateModified': (updatedDate || pubDate).toISOString(),
  'author': {
    '@type': 'Person',
    'name': author,
    ...(authorGitHub ? { 'url': `https://github.com/${authorGitHub}` } : {}),
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'SHREWD.',
    'url': siteOrigin,
    'logo': {
      '@type': 'ImageObject',
      'url': new URL('/favicon.svg', siteOrigin).href,
    },
  },
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  'keywords': [category, ...(tags || [])].join(', '),
};
---

<BaseLayout title={title} description={description} image={image}>
  <!-- Schema.org JSON-LD (Sanitized against script tag injection) -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData).replace(/</g, '\\u003c')} />

  <!-- Reading Progress Bar -->
  <div
    id="reading-progress"
    role="progressbar"
    aria-label="Reading progress"
    aria-valuenow="0"
    aria-valuemin="0"
    aria-valuemax="100"
  ></div>

  <Header />

  <main id="main-content">
    <article>
      <!-- Post Hero -->
      <header class="post-hero">
        <div class="container container--narrow">
          <!-- Meta -->
          <div class="post-meta">
            <span class={`badge ${categoryBadge}`}>{category}</span>
            {difficulty && (
              <span class={`difficulty-badge difficulty--${difficulty.toLowerCase()}`}>
                {difficulty}
              </span>
            )}
            <span class="post-meta-separator">·</span>
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            {updatedDate && (
              <>
                <span class="post-meta-separator">·</span>
                <span>Updated {updatedFormatted}</span>
              </>
            )}
            <span class="post-meta-separator">·</span>
            <span>{readTimeMin} min read</span>
          </div>

          <h1 class="post-title">{title}</h1>
          <p class="post-description">{description}</p>

          <!-- Author row -->
          <div class="post-author-row">
            <div class="author-avatar" aria-hidden="true">{authorInitial}</div>
            <div>
              <div class="author-name-lg">{author}</div>
              {tags && tags.length > 0 && (
                <div class="post-tags">
                  {tags.map(tag => (
                    <span class="post-tag">#{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      </header>

      <!-- Cover Image -->
      {image && (
        <div class="container container--narrow">
          <img
            src={image}
            alt={`Cover image for ${title}`}
            class="post-cover"
            loading="eager"
          />
        </div>
      )}

      <!-- Post Body & TOC -->
      <div class="container container--narrow">
        {tocHeadings.length >= 2 && (
          <nav class="table-of-contents" aria-label="Table of contents">
            <div class="toc-header">
              <span class="toc-icon" aria-hidden="true">📋</span>
              <span class="toc-title">Table of Contents</span>
            </div>
            <ul class="toc-list">
              {tocHeadings.map(h => (
                <li class={`toc-item toc-depth-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <div class="prose post-body">
          <slot />
        </div>

        <!-- Share Section -->
        <div class="share-section">
          <span class="share-label">Share this research</span>
          <button id="copy-url-btn" class="share-copy-btn" type="button" aria-label="Copy article URL">
            🔗 Copy Link
          </button>
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(postUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--ghost btn--sm"
          >
            𝕏 Share
          </a>
        </div>

        <!-- Author Bio -->
        {authorBio && (
          <div class="author-bio-card">
            <div class="author-bio-avatar" aria-hidden="true">{authorInitial}</div>
            <div class="author-bio-content">
              <h4>{author}</h4>
              <p>{authorBio}</p>
              {authorGitHub && (
                <a
                  href={`https://github.com/${authorGitHub}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn--ghost btn--sm"
                  style="margin-top: 0.75rem; display: inline-flex;"
                >
                  GitHub →
                </a>
              )}
            </div>
          </div>
        )}

        <!-- Related Research -->
        {relatedPosts.length > 0 && (
          <section class="related-posts-section" aria-labelledby="related-research-heading">
            <div class="related-header">
              <h3 id="related-research-heading">Related Lab Research</h3>
              <a href="/blog" class="related-view-all">View all →</a>
            </div>
            <div class="grid-2">
              {relatedPosts.map(p => (
                <BlogCard
                  title={p.data.title}
                  slug={p.id.replace(/\.md$/, '')}
                  excerpt={p.data.description}
                  date={p.data.pubDate}
                  author={p.data.author}
                  category={p.data.category}
                  readTime={getReadingTime(p.body)}
                  image={p.data.image}
                  difficulty={p.data.difficulty}
                />
              ))}
            </div>
          </section>
        )}
      </div>
    </article>
  </main>

  <Footer />

  <script>
    // Reading Progress Bar
    const progressBar = document.getElementById('reading-progress');
    const article = document.querySelector('article');

    if (progressBar && article) {
      window.addEventListener('scroll', () => {
        const articleTop = article.offsetTop;
        const articleHeight = article.offsetHeight;
        const windowHeight = window.innerHeight;
        const scrollY = window.scrollY;

        const progress = Math.min(
          Math.max((scrollY - articleTop + windowHeight * 0.1) / (articleHeight - windowHeight * 0.9), 0),
          1
        );
        const percent = Math.round(progress * 100);
        progressBar.style.width = `${percent}%`;
        progressBar.setAttribute('aria-valuenow', String(percent));
      }, { passive: true });
    }

    // Copy URL
    const copyBtn = document.getElementById('copy-url-btn');
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyBtn.textContent = '✅ Copied!';
        setTimeout(() => {
          copyBtn.textContent = '🔗 Copy Link';
        }, 2000);
      } catch {
        copyBtn.textContent = '❌ Failed';
      }
    });
  </script>
</BaseLayout>

<style>
  .post-author-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .author-name-lg {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .post-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .post-tag {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
  }

  .table-of-contents {
    margin: var(--space-8) 0 var(--space-4);
    padding: var(--space-5) var(--space-6);
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .toc-title {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-cyan);
    font-family: var(--font-mono);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .toc-item a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color var(--transition-fast);
  }

  .toc-item a:hover {
    color: var(--color-cyan);
  }

  .toc-depth-3 {
    padding-left: var(--space-4);
    font-size: 0.8125rem;
  }

  .post-body {
    padding: var(--space-10) 0;
  }

  .related-posts-section {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .related-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .related-header h3 {
    font-size: 1.25rem;
    margin: 0;
  }

  .related-view-all {
    color: var(--color-cyan);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .related-view-all:hover {
    text-decoration: underline;
  }
</style>
